# Copy to .env and adjust. Never commit real secrets.
PORT=8080

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=conduit
DATABASE_USER=conduit
DATABASE_PASSWORD=change-me
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
# Apply versioned migrations at startup (set to false to run them elsewhere)
DATABASE_RUN_MIGRATIONS=true

# REQUIRED, minimum 32 characters (the app refuses to start otherwise)
JWT_SECRET=replace-with-a-long-random-string-of-32+chars
JWT_TTL_MINUTES=720

# Comma-separated list
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# bcrypt cost (4-31); 12 is a good production default
BCRYPT_COST=12
